{
  "name": "openapi-builder",
  "version": "1.0.0",
  "description": "Pipeline-driven OpenAPI builder",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "test": "jest --runInBand",
    "spectral:lint": "npx @stoplight/spectral lint ./openapi-spec/ultimate-enterprise.yaml -r ./.spectral.yaml || true",
    "generate:sdk": "npx @openapitools/openapi-generator-cli generate -i ./openapi-spec/ultimate-enterprise.yaml -g typescript-axios -o ./dist/sdk --skip-validate-spec",
    "package:zip": "bash ./scripts/make_package.sh"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.5.0",
    "@stoplight/spectral-cli": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3"
  }
}
